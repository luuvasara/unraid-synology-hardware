#!/bin/bash
# synohw-macfix - give the 4 igb ports the real Synology MACs (Unraid boots with 00:a0:c9:00:00:0X).
# Written: 2026-10-24, rewritten 2026-10-25 to use Unraid's own udev hook instead of a per-boot fix-up.
#
# How (Unraid 7.3.4 sources, read in bzroot; see README "MAC fix"):
#  * rc.S.cont:33-40 copies /boot/config/udev/*.rules into /etc/udev/rules.d BEFORE udevd starts
#    (rc.S.cont:54) and long before rc.inet1 (rc.M:65). So a udev rule on flash sets the MAC when the
#    NIC appears, before bond0/br0/DHCP exist: no network restart at boot, first DHCP lease is real.
#  * Unraid's NIC naming (70-persistent-net.rules, saved to /boot/config/network-rules.cfg by
#    rc.udev:155-163) matches ATTR{address} as seen at the "add" event. A genuine add always carries
#    the NVM placeholder (the driver re-reads it, also after rc.udev:152-153 reloads igb), and our RUN
#    only executes after all rules were evaluated (eudev udev_event_execute_run), so the naming rules
#    keep matching the placeholders. The extra NAME="$kernel" line covers the one case where an add
#    event sees a NIC we already changed (a synthetic `udevadm trigger --action=add`, e.g.
#    rc.udev:129): it pins the current name so 75-persistent-net-generator.rules:18 does not write a
#    second rule for the real MAC into 70-persistent-net.rules / network-rules.cfg.
#
# Verbs:  (none)|run  write/remove the udev rule (per MACFIX), then apply live (detached) if a port
#                     still has the placeholder.   Idempotent: no-op once the MACs are real.
#         rules       only write/remove the udev rule
#         apply       live apply: rc.inet1 <top>_stop, ip link set dev ethN address, rc.inet1 <top>_start
#         status      ports, PCI address, current and DOM MAC, rule state
# Env: SYNOHW_SYSNET SYNOHW_IP SYNOHW_INET1 SYNOHW_VENDER_FILE SYNOHW_UDEV_ROM SYNOHW_UDEV_RAM
#      SYNOHW_BUSY_PIDFILES SYNOHW_DETACH(=no for tests) SYNOHW_UDEVADM
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "$HERE/synohw-lib.sh"
synohw_load_cfg
SYSNET=${SYNOHW_SYSNET:-/sys/class/net}
IP=${SYNOHW_IP:-/sbin/ip}
INET1=${SYNOHW_INET1:-/etc/rc.d/rc.inet1}
ROM=${SYNOHW_UDEV_ROM:-/boot/config/udev/70-synology-hardware-mac.rules}
RAM=${SYNOHW_UDEV_RAM:-/etc/udev/rules.d/70-synology-hardware-mac.rules}
# 2026.10.25i: the plugin was called synology-hw before; its rule files (same content, old name) are removed so that only one
# rule set exists (both would set the same MACs, but a stale old file would outlive MACFIX=no)
LEGACY="${SYNOHW_UDEV_LEGACY:-/boot/config/udev/70-synology-hw-mac.rules /etc/udev/rules.d/70-synology-hw-mac.rules}"
UDEVADM=${SYNOHW_UDEVADM:-udevadm}
BUSY=${SYNOHW_BUSY_PIDFILES:-/var/run/dockerd.pid /var/run/libvirt/libvirtd.pid}
MACCACHE=$SYNOHW_RUN/macs

# ---- DOM MACs (cached per boot in /var/run, so the DOM is mounted read-only at most once) ----
load_macs() {
  local out
  if [ -n "${SYNOHW_VENDER_FILE:-}" ]; then out=$("$HERE/synohw-vender" decode "$SYNOHW_VENDER_FILE") || return 1
  elif [ -s "$MACCACHE" ]; then out=$(<"$MACCACHE")
  else
    out=$("$HERE/synohw-vender" find 2> >(while IFS= read -r l; do synohw_log "vender: $l"; done)) || return 1
    mkdir -p "$SYNOHW_RUN" && printf '%s\n' "$out" >"$MACCACHE"
  fi
  mapfile -t MACS < <(awk '$1=="mac"{print $3}' <<<"$out")
  [ ${#MACS[@]} -gt 0 ]
}

# physical PCI NICs, sorted by PCI address: lines "<pci> <ifname>"
pci_nics() {
  local n pci
  for n in "$SYSNET"/*; do
    [ -e "$n/device" ] && [ ! -e "$n/wireless" ] || continue
    pci=$(basename "$(readlink -f "$n/device")")
    [[ $pci =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]] || continue
    printf '%s %s\n' "$pci" "${n##*/}"
  done | sort
}

# ---- the udev rule ----
rule_text() {   # needs MACS; port i (PCI order) gets MAC i
  local i=0 pci nic mac
  echo "# synology-hardware: real Synology MACs for the DS2415+ ports (generated by synohw-macfix, do not edit)."
  echo "# Source: DOM 'vender' file, MAC n -> n-th PCI network function. Remove: set MACFIX=no or remove the plugin."
  while read -r pci nic; do
    mac=${MACS[$i]:-}; i=$((i + 1))
    [ -n "$mac" ] || continue
    echo "ACTION==\"add\", SUBSYSTEM==\"net\", KERNELS==\"$pci\", ATTR{address}==\"$mac\", NAME!=\"?*\", NAME=\"\$kernel\""
    echo "ACTION==\"add\", SUBSYSTEM==\"net\", KERNELS==\"$pci\", ATTR{address}==\"$PLACEHOLDER_MAC_PREFIX:*\", RUN+=\"/sbin/ip link set dev \$name address $mac\""
  done < <(pci_nics)
}

write_if_differs() {  # $1 file, $2 content ; rc 0 = written, 1 = unchanged, 2 = error
  local f=$1 c=$2
  [ -f "$f" ] && [ "$(cat "$f")" = "$c" ] && return 1
  mkdir -p "$(dirname "$f")" && printf '%s\n' "$c" >"$f.tmp" && mv -f "$f.tmp" "$f" && return 0
  rm -f "$f.tmp"; return 2
}

do_rules() {
  local f
  for f in $LEGACY; do [ -e "$f" ] && { rm -f "$f" && synohw_log "macfix: removed the old plugin's rule $f" || synohw_log "macfix: cannot remove $f"; }; done
  if [ "$MACFIX" != yes ]; then
    for f in "$ROM" "$RAM"; do [ -e "$f" ] && { rm -f "$f"; synohw_log "macfix: MACFIX=$MACFIX, removed $f"; }; done
    return 0
  fi
  load_macs || { synohw_log "macfix: cannot read the DOM MACs; udev rule left as it is"; return 1; }
  local text; text=$(rule_text)
  grep -q '^ACTION' <<<"$text" || { synohw_log "macfix: no PCI network ports found; udev rule not written"; return 1; }
  local rc=0
  for f in "$ROM" "$RAM"; do
    write_if_differs "$f" "$text"
    case $? in 0) synohw_log "macfix: wrote $f" ;; 1) : ;; *) synohw_log "macfix: cannot write $f"; rc=1 ;; esac
  done
  return $rc
}

pending_ports() {  # lines "<ifname> <mac>" for ports that still carry the placeholder
  local i=0 pci nic mac cur
  while read -r pci nic; do
    mac=${MACS[$i]:-}; i=$((i + 1))
    [ -n "$mac" ] || continue
    cur=$(<"$SYSNET/$nic/address")
    case "$cur" in "$PLACEHOLDER_MAC_PREFIX"*) echo "$nic $mac" ;; esac
  done < <(pci_nics)
}

top_of() {  # nic -> bond -> bridge: echo the top-most master (or the nic itself)
  local d=$1 m
  while [ -e "$SYSNET/$d/master" ]; do m=$(basename "$(readlink -f "$SYSNET/$d/master")"); d=$m; done
  echo "$d"
}

is_up() { local f; f=$(cat "$SYSNET/$1/flags" 2>/dev/null) || return 1; (( f & 1 )); }

services_busy() {
  local p
  for p in $BUSY; do [ -r "$p" ] && kill -0 "$(<"$p")" 2>/dev/null && { echo "$p"; return 0; }; done
  return 1
}

do_apply() {
  [ "$MACFIX" = yes ] || return 0
  load_macs || { synohw_log "macfix: cannot read the DOM MACs"; return 1; }
  mkdir -p "$SYNOHW_RUN"
  mkdir "$SYNOHW_RUN/apply.lock" 2>/dev/null || { synohw_log "macfix: another live apply is running"; return 0; }
  trap 'rmdir "$SYNOHW_RUN/apply.lock" 2>/dev/null' EXIT
  local -a P=() tops=() direct=()
  mapfile -t P < <(pending_ports)
  [ ${#P[@]} -gt 0 ] || { synohw_log "macfix: all ports already have the real MAC, nothing to do"; return 0; }
  local busy; if busy=$(services_busy); then
    synohw_log "macfix: not applied live because a service using the bridge is running ($busy); the udev rule applies the MACs at the next boot"
    return 0
  fi
  local p nic mac t rc=0
  for p in "${P[@]}"; do
    nic=${p% *}; t=$(top_of "$nic")
    if [ "$t" = "$nic" ] && ! is_up "$nic"; then direct+=("$nic"); continue; fi   # unused port: no rc.inet1
    [[ " ${tops[*]} " == *" $t "* ]] || tops+=("$t")
  done
  for t in "${tops[@]}"; do synohw_log "macfix: rc.inet1 ${t}_stop"; "$INET1" "${t}_stop" || { synohw_log "macfix: rc.inet1 ${t}_stop returned $?"; rc=1; }; done
  for p in "${P[@]}"; do
    nic=${p% *}; mac=${p#* }
    synohw_log "macfix: $nic $(<"$SYSNET/$nic/address") -> $mac"
    "$IP" link set dev "$nic" address "$mac" || { synohw_log "macfix: ip link set dev $nic address $mac failed"; rc=1; }
  done
  for t in "${tops[@]}"; do
    synohw_log "macfix: rc.inet1 ${t}_start"
    "$INET1" "${t}_start" || { synohw_log "macfix: rc.inet1 ${t}_start returned $?"; rc=1; }
    if [ ! -e "$SYSNET/$t" ]; then synohw_log "macfix: $t missing after start, retrying once"; "$INET1" "${t}_start" || rc=1; fi
  done
  return $rc
}

do_run() {
  do_rules
  [ "$MACFIX" = yes ] || return 0
  load_macs 2>/dev/null || return 0
  if [ -z "$(pending_ports)" ]; then synohw_log "macfix: MACs already real, nothing to apply"; return 0; fi
  if [ "${SYNOHW_DETACH:-yes}" = no ]; then do_apply; return $?; fi
  # detached: rc.inet1 br0_stop cuts the network, which may be the SSH session running 'plugin install'
  setsid -f "$0" apply </dev/null >/dev/null 2>&1
  synohw_log "macfix: live apply started in the background (network drops for a few seconds)"
}

do_status() {
  load_macs 2>/dev/null || MACS=()
  local i=0 pci nic cur mac st
  while read -r pci nic; do
    mac=${MACS[$i]:-?}; i=$((i + 1)); cur=$(<"$SYSNET/$nic/address")
    if [ "$cur" = "$mac" ]; then st=real; else case "$cur" in "$PLACEHOLDER_MAC_PREFIX"*) st=placeholder ;; *) st=other ;; esac; fi
    echo "port $nic $pci $cur $mac $st"
  done < <(pci_nics)
  [ -e "$ROM" ] && echo "rule $ROM present" || echo "rule $ROM absent"
  [ -s "$MACCACHE" ] && sed -n 's/^sn /sn /p' "$MACCACHE"
  return 0
}

case "${1:-run}" in
  run) do_run ;;
  rules) do_rules ;;
  apply) do_apply ;;
  status) do_status ;;
  *) echo "usage: $0 [run|rules|apply|status]" >&2; exit 2 ;;
esac
