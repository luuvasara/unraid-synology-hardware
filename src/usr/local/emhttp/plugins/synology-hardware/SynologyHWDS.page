_(Power on after AC loss)_ (AC_RECOVERY):
: <select name="AC_RECOVERY" aria-label="Power on after AC loss (AC_RECOVERY)">
  <?=mk_option($cfg['AC_RECOVERY'], "keep", "Keep (send nothing)")?>
  <?=mk_option($cfg['AC_RECOVERY'], "on", "On (send q)")?>
  <?=mk_option($cfg['AC_RECOVERY'], "off", "Off (send p)")?>
